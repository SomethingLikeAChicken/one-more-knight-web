# Copy to .env.local for development. On Vercel, set these in Project Settings → Environment Variables.

# Required. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Postgres connection string (Neon). Leave unset locally to use the JSON file
# store in .data/ instead — no database needed for development.
DATABASE_URL=

# Dev-only fake login (any username, no password). NEVER set in production.
DEV_LOGIN=1

# OAuth providers — each activates automatically when its ID is set.
# Callback URLs to register (replace localhost origin with the Vercel URL in prod):
#   Google:  http://localhost:3000/api/auth/callback/google
#   GitHub:  http://localhost:3000/api/auth/callback/github
#   Discord: http://localhost:3000/api/auth/callback/discord
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
